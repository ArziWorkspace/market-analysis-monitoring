  change_percent     Decimal?         @db.Decimal(7, 2)
  change_direction   String?
  region             String?
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  market_data_runs   market_data_runs @relation(fields: [market_data_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_world_run")

  @@index([market_data_run_id], map: "idx_world_mdr")
