  market_data_runs        market_data_runs @relation(fields: [market_data_run_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([phase_id], map: "idx_portfolio_recommendations_phase")
  @@index([pipeline_id], map: "idx_portfolio_recommendations_pipeline")
  @@index([market_data_run_id], map: "idx_portfolio_recommendations_run_id")
  @@index([ticker], map: "idx_portfolio_recommendations_ticker")
}

model report_metadata {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
