  buy_count          Int?
  hold_count         Int?
  reduce_count       Int?
  total_words        Int?
  html_content       String?
  status             String?
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  updated_at         DateTime?        @default(now()) @db.Timestamp(6)
}

enum PipelineStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum PhaseStatus {
  pending
  running
  complete
  failed
}

enum ReportType {
  WEEKLY
}

enum SectionType {
  EXECUTIVE_SUMMARY
  MACRO_ANALYSIS
  IHSG_ANALYSIS
  SECTOR_MATRIX
  TOP_PICKS
  STOCK_DEEP_DIVES
  REFERENCES
}

enum BlockType {
  HEADING
  PARAGRAPH
  TABLE
  LIST
  INSIGHT
  CAUSAL_CHAIN
}

enum StockSubsectionType {
  SEJARAH
  BUSINESS_MODEL
  REVENUE
  MOAT
  FINANCIAL
  FUTURE_PLAN
  THEME_CONNECTION
  INVESTMENT_THESIS
}
